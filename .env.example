# Cloudflare R2 Credentials
# Get these from your Cloudflare dashboard:
# https://dash.cloudflare.com → R2 → Manage R2 API Tokens

R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: Custom public domain for file URLs (e.g., https://files.example.com)
# If not set, the R2 S3-compatible endpoint URL will be used
R2_PUBLIC_DOMAIN=
